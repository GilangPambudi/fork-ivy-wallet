# Copy to .env and fill in. Never commit the real .env.

# Database password. Use only letters and digits: it is placed inside a URL.
RIVY_DB_PASSWORD=change-me

# The only Google account that may sign in.
RIVY_ALLOWED_EMAIL=you@example.com

# OAuth client ID of type "Web application" from Google Cloud Console.
# The Android app requests its ID tokens for this client ID.
RIVY_GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# Optional. Secret for the Gmail forwarder that sends bank emails in.
# At least 24 characters, generate one with: openssl rand -hex 24
# Leave empty to turn the email inbox off.
RIVY_INGEST_TOKEN=
